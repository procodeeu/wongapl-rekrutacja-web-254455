---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';

export async function getStaticPaths() {
  const projectEntries = await getCollection('ourProjects');
  return projectEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

function formatDate(date: Date): string {
  return date.toLocaleDateString('pl-PL', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout title={`${entry.data.title} - PROCODE`} description={entry.data.description}>
  <main class="project-article">
    <div class="container">
      <nav class="breadcrumb" aria-label="Nawigacja okruszkami">
        <ol class="breadcrumb-list">
          <li><a href="/">Strona główna</a></li>
          <li><span aria-hidden="true">→</span></li>
          <li><a href="/nasze-projekty">Nasze projekty</a></li>
          <li><span aria-hidden="true">→</span></li>
          <li><span aria-current="page">{entry.data.title}</span></li>
        </ol>
      </nav>

      <article class="project-content">
        <header class="project-header">
          <h1>{entry.data.title}</h1>
          <time class="project-date text-meta" datetime={entry.data.date.toISOString()}
            >{formatDate(entry.data.date)}</time
          >
          {
            entry.data.description && (
              <p class="project-description text-description">{entry.data.description}</p>
            )
          }
        </header>

        <section class="project-body">
          <Content />
        </section>

        <footer class="project-footer">
          <a href="/nasze-projekty" class="btn btn-secondary">← Powrót do wszystkich projektów</a>
        </footer>
      </article>
    </div>
  </main>
</Layout>

<style>
  .project-article {
    min-height: 100vh;
    padding: 4rem 0;
    color: white;
  }

  .breadcrumb {
    margin-bottom: 2rem;
    font-size: 0.9rem;
    color: var(--text-light);
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .breadcrumb-list li {
    display: flex;
    align-items: center;
  }

  .breadcrumb a {
    color: var(--primary-green);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid transparent;
    transition: border-bottom-color 0.2s ease;
  }

  .breadcrumb a:hover {
    border-bottom-color: var(--primary-green);
  }

  .breadcrumb span {
    margin: 0 0.5rem;
    color: var(--accent-green);
  }

  .project-header {
    padding: 3rem 3rem 2rem;
  }

  .project-header h1 {
    margin: 0 0 1rem 0;
    color: var(--lime-green);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 700;
  }

  .project-date {
    font-size: 0.9rem;
    display: block;
    margin-bottom: 1rem;
  }

  .project-description {
    font-size: 1.125rem;
    margin: 0;
    font-style: italic;
  }

  .project-body {
    padding: 2rem 3rem;
    line-height: 1.7;
  }

  .project-body h1,
  .project-body h2,
  .project-body h3 {
    color: var(--lime-green);
    margin: 2rem 0 1rem 0;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .project-body h1 {
    font-size: 1.875rem;
  }

  .project-body h2 {
    font-size: 1.5rem;
  }

  .project-body h3 {
    font-size: 1.25rem;
  }

  .project-body p {
    margin-bottom: 1.5rem;
    color: var(--text-light);
  }

  .project-body ul,
  .project-body ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .project-body li {
    margin-bottom: 0.5rem;
    color: var(--text-light);
  }

  .project-body strong {
    color: var(--accent-green);
    font-weight: 700;
  }

  .project-body code {
    background: rgba(16, 185, 129, 0.2);
    color: var(--primary-green);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
  }

  .project-footer {
    padding: 2rem 3rem 3rem;
  }

  @media (max-width: 768px) {
    .project-article {
      padding: 2rem 0;
    }

    .project-header,
    .project-body,
    .project-footer {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .project-header {
      padding-top: 2rem;
      padding-bottom: 1.5rem;
    }

    .project-body {
      padding-top: 1.5rem;
      padding-bottom: 1.5rem;
    }

    .project-footer {
      padding-top: 1.5rem;
      padding-bottom: 2rem;
    }

    .breadcrumb {
      padding: 0 1rem;
    }

    .breadcrumb-list {
      flex-wrap: wrap;
      gap: 0.25rem;
    }
  }
</style>
